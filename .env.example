# ───────────── Shorts AI Studio – konfiguracja ─────────────
# Aplikacja działa bez żadnych kluczy (generator programowy).
# Poniższe zmienne są opcjonalne.

# Gdzie powstaje plik MP4:
#   server  – na tym serwerze (Remotion + Chrome), domyślnie lokalnie / na własnym serwerze
#   browser – w przeglądarce użytkownika (iPhone, komputer), domyślnie na Vercelu
# RENDER_MODE=browser

# Klucz licencji Remotion dla renderowania w przeglądarce. Osoby prywatne i firmy do 3 osób:
# "free-license" (domyślnie). Większe firmy: klucz licencji firmowej z remotion.pro.
# NEXT_PUBLIC_REMOTION_LICENSE_KEY=free-license

# Folder na wyrenderowane filmy MP4 (domyślnie ./renders)
# RENDERS_DIR=./renders

# Ścieżka do Chrome Headless Shell / Chromium używanego przez Remotion.
# Jeśli pusta – aplikacja spróbuje wykryć przeglądarkę Playwright,
# a w ostateczności Remotion pobierze ją automatycznie.
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell

# Liczba równoległych wątków renderowania (domyślnie: połowa rdzeni CPU)
# RENDER_CONCURRENCY=4

# ───────────── Prawdziwy generator wideo AI (opcjonalnie) ─────────────
# 1) Replicate (https://replicate.com) – dowolny model text-to-video
# REPLICATE_API_TOKEN=r8_xxx
# REPLICATE_MODEL=minimax/video-01
# Opcjonalny szablon wejścia modelu (JSON). Dostępne zmienne:
# {{prompt}}, {{duration}}, {{aspect_ratio}}
# REPLICATE_INPUT_TEMPLATE={"prompt":"{{prompt}}","aspect_ratio":"{{aspect_ratio}}","duration":{{duration}}}

# 2) Własny endpoint HTTP (np. Twój serwer z modelem AI)
# POST {AI_VIDEO_HTTP_URL} z JSON { prompt, duration, aspectRatio, width, height }
# Odpowiedź: { "videoUrl": "..." } lub { "statusUrl": "..." } (odpytywany aż zwróci videoUrl)
# AI_VIDEO_HTTP_URL=https://moj-serwer.pl/api/generate-video
# AI_VIDEO_HTTP_TOKEN=sekret
