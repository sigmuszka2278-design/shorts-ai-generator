[
 {
  "start": 0.8,
  "end": 1.36,
  "text": "Co by było,"
 },
 {
  "start": 1.36,
  "end": 2.83,
  "text": "gdyby nikt tego nie naprawił?"
 },
 {
  "start": 3.2,
  "end": 4.54,
  "text": "Region bez elektryków?"
 },
 {
  "start": 4.76,
  "end": 6.7,
  "text": "Ciemne bloki, stojące fabryki,"
 },
 {
  "start": 6.7,
  "end": 7.81,
  "text": "rozładowane auta."
 },
 {
  "start": 8.5,
  "end": 9.96,
  "text": "Ale Dolny Śląsk rośnie!"
 },
 {
  "start": 10.18,
  "end": 11.62,
  "text": "Nowe osiedla, fabryki,"
 },
 {
  "start": 11.62,
  "end": 12.48,
  "text": "fotowoltaika,"
 },
 {
  "start": 12.48,
  "end": 15.3,
  "text": "ładowarki aut elektrycznych i pompy ciepła."
 },
 {
  "start": 15.52,
  "end": 17.57,
  "text": "Bez elektryka nic z tego nie ruszy."
 },
 {
  "start": 18.3,
  "end": 19.86,
  "text": "Jak wygląda dzień elektryka?"
 },
 {
  "start": 20.08,
  "end": 21.23,
  "text": "Rano plan i schemat."
 },
 {
  "start": 21.45,
  "end": 23.74,
  "text": "Potem montaż gniazdek i oświetlenia,"
 },
 {
  "start": 23.74,
  "end": 25.47,
  "text": "szukanie usterek i pomiary."
 },
 {
  "start": 25.69,
  "end": 26.69,
  "text": "Na koniec test,"
 },
 {
  "start": 26.69,
  "end": 28.82,
  "text": "czy wszystko działa bezpiecznie."
 },
 {
  "start": 30.3,
  "end": 32.38,
  "text": "Co trzeba umieć? Precyzja."
 },
 {
  "start": 32.6,
  "end": 33.8,
  "text": "Logiczne myślenie,"
 },
 {
  "start": 33.8,
  "end": 35.66,
  "text": "bo każda usterka to zagadka."
 },
 {
  "start": 35.88,
  "end": 38.56,
  "text": "Bezpieczeństwo zawsze na pierwszym miejscu."
 },
 {
  "start": 38.78,
  "end": 39.88,
  "text": "I praca w zespole."
 },
 {
  "start": 42.3,
  "end": 43.13,
  "text": "Jak zacząć?"
 },
 {
  "start": 43.13,
  "end": 45.33,
  "text": "Technikum – technik elektryk,"
 },
 {
  "start": 45.55,
  "end": 47.54,
  "text": "albo szkoła branżowa – elektryk."
 },
 {
  "start": 47.76,
  "end": 49.82,
  "text": "Do tego praktyki u fachowców,"
 },
 {
  "start": 49.82,
  "end": 51.53,
  "text": "a potem uprawnienia SEP."
 },
 {
  "start": 52.8,
  "end": 54.89,
  "text": "Region z elektrykami? Świeci,"
 },
 {
  "start": 54.89,
  "end": 56.33,
  "text": "działa, rozwija się."
 },
 {
  "start": 56.55,
  "end": 57.78,
  "text": "Elektryk – zawód,"
 },
 {
  "start": 57.78,
  "end": 59.51,
  "text": "który włącza przyszłość!"
 }
]
