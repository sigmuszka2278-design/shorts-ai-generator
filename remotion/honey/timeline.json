 "sentences": [
  {
   "scene": "spoon-intro",
   "text": "Ten miód mógłby mieć trzy tysiące lat.",
   "start": 0.14,
   "end": 2.11
  },
  {
   "scene": "spoon-intro",
   "text": "I nadal dałoby się go zjeść.",
   "start": 2.25,
   "end": 3.78
  },
  {
   "scene": "tomb",
   "text": "Archeolodzy znajdowali miód w egipskich grobowcach.",
   "start": 3.92,
   "end": 6.86
  },
  {
   "scene": "tomb",
   "text": "Po tysiącach lat wciąż się nie zepsuł.",
   "start": 7.0,
   "end": 9.24
  },
  {
   "scene": "bacteria",
   "text": "Pierwszy powód: miód ma bardzo mało wody.",
   "start": 10.12,
   "end": 12.73
  },
  {
   "scene": "bacteria",
   "text": "Bakterie, które do niego trafią, dosłownie wysychają.",
   "start": 12.87,
   "end": 16.49
  },
  {
   "scene": "ph-strip",
   "text": "Drugi: jest kwaśny.",
   "start": 18.12,
   "end": 19.66
  },
  {
   "scene": "ph-strip",
   "text": "Mało który drobnoustrój przeżyje w takim środowisku.",
   "start": 19.8,
   "end": 22.67
  },
  {
   "scene": "bees",
   "text": "Trzeci: pszczoły dodają do niego enzym, który wytwarza nadtlenek wodoru.",
   "start": 25.12,
   "end": 29.26
  },
  {
   "scene": "bees",
   "text": "Naturalny środek antybakteryjny.",
   "start": 29.4,
   "end": 31.42
  },
  {
   "scene": "spoon-outro",
   "text": "Jedyne, co może mu zaszkodzić, to wilgoć.",
   "start": 33.12,
   "end": 35.76
  },
  {
   "scene": "spoon-outro",
   "text": "Więc zakręcaj słoik.",
   "start": 35.9,
   "end": 37.26
  },
  {
   "scene": "spoon-outro",
   "text": "A ty wiedziałeś, że miód się nie psuje?",
   "start": 37.4,
   "end": 39.41
  }
 ],
